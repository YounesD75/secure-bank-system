<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level - %msg%n"/>
        </Console>
    </Appenders>
    
    <Loggers>
        <!-- Votre logger personnalisé -->
        <Logger name="SecureBank" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        
        <!-- Spark logs → les cacher -->
        <Logger name="org.apache.spark" level="ERROR"/>
        <Logger name="org.sparkproject" level="ERROR"/>
        <Logger name="org.apache.hadoop" level="ERROR"/>
        <Logger name="org.apache.parquet" level="ERROR"/>
        <Logger name="org.eclipse.jetty" level="ERROR"/>
        
        <!-- Root logger -->
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>